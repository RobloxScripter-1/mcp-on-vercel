{
  "rewrites": [
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/oauth"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth"
    },
    {
      "source": "/register",
      "destination": "/api/oauth"
    },
    {
      "source": "/authorize",
      "destination": "/api/oauth"
    },
    {
      "source": "/token",
      "destination": "/api/oauth"
    },
    {
      "source": "/oauth/diagnose",
      "destination": "/api/oauth"
    },
    {
      "source": "/oauth/github/callback",
      "destination": "/api/oauth"
    },
    {
      "source": "/oauth/status",
      "destination": "/api/oauth"
    },
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/(.+)",
      "destination": "/api/server"
    }
  ],
  "functions": {
    "api/server.ts": {
      "maxDuration": 60
    },
    "api/mcp.ts": {
      "maxDuration": 60
    },
    "api/oauth.ts": {
      "maxDuration": 30
    }
  }
}
