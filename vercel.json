{
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource/mcp", "destination": "/api/oauth?route=protected-resource" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth?route=protected-resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth?route=authorization-server" },
    { "source": "/register", "destination": "/api/oauth?route=register" },
    { "source": "/authorize", "destination": "/api/oauth?route=authorize" },
    { "source": "/token", "destination": "/api/oauth?route=token" },
    { "source": "/oauth/github/callback", "destination": "/api/oauth?route=github-callback" },
    { "source": "/oauth/status", "destination": "/api/oauth?route=status" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/(.+)", "destination": "/api/server" }
  ],
  "functions": {
    "api/server.ts": { "maxDuration": 60 },
    "api/mcp.ts": { "maxDuration": 60 },
    "api/oauth.ts": { "maxDuration": 30 }
  }
}
